# Local SQLite. Create data/ before running migrations.
# Never commit a real environment file or database.
DATABASE_URL=file:./data/emaus.db
# Hosted libSQL/Turso only:
# DATABASE_AUTH_TOKEN=

# Generate a unique secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret
# Application URL for authentication and public check-in links.
BETTER_AUTH_URL=http://localhost:3000

# Optional local demo password. db:seed DELETES existing application records.
# SEED_PASSWORD=

# Optional assistant. Configure one server-side provider key, then restart.
# Without a key the rest of the app works and the assistant shows setup guidance.
OPENAI_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional provider override:
# openai | groq | cerebras | gemini | anthropic | openai-compatible
# EMAUS_AI_PROVIDER=openai
# EMAUS_AI_MODEL=your-tool-capable-model-id
# OpenAI Responses API reasoning effort: none | low | medium | high
# EMAUS_AI_EFFORT=low

# Custom OpenAI-compatible endpoint (all three required):
# EMAUS_AI_PROVIDER=openai-compatible
# EMAUS_AI_BASE_URL=https://your-provider.example/v1
# EMAUS_AI_API_KEY=
# EMAUS_AI_MODEL=your-tool-capable-model-id
# Optional cost estimates, USD per million tokens. Zero is not a free API call.
# EMAUS_AI_PRICE_IN=0
# EMAUS_AI_PRICE_OUT=0

# Defaults and the model catalog are in src/server/ai/agent.ts.
# Provider availability, limits, pricing, and data terms depend on your account.

# Public synthetic-data demo only. Never enable on a database with real records.
# Protects shared accounts/provider settings and limits aggregate AI requests.
# EMAUS_DEMO_MODE=false
