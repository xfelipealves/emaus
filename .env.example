# Arquivo SQLite local (criado automaticamente). Nunca commite um .env real.
DATABASE_URL=file:./data/emaus.db

# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret
# URL pública do app (usada em links e no QR de check-in)
BETTER_AUTH_URL=http://localhost:3000

# Assistente (IA): escolha UM provedor. Sem nenhum, a página do assistente mostra como configurar.
# Gratuitos (formato OpenAI, modo enxuto por causa dos limites por minuto):
#   GROQ_API_KEY      → console.groq.com (não treina com seus dados; ative retenção zero em Data Controls)
#   CEREBRAS_API_KEY  → cloud.cerebras.ai (limite grátis maior por minuto)
#   GEMINI_API_KEY    → aistudio.google.com (no plano grátis o Google pode usar os dados para melhorar produtos)
GROQ_API_KEY=
# Pago, mais capaz: Claude (Anthropic)
# ANTHROPIC_API_KEY=
# Forçar provedor/modelo (opcional): groq | cerebras | gemini | anthropic | openai-compatible
# EMAUS_AI_PROVIDER=groq
# EMAUS_AI_MODEL=qwen/qwen3.8-27b
# Qualquer API compatível com OpenAI:
# EMAUS_AI_BASE_URL=https://.../v1
# EMAUS_AI_API_KEY=
