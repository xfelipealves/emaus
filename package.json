{
  "name": "emaus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --passWithNoTests",
    "test:e2e": "node scripts/e2e/run.mjs",
    "test:e2e:safety": "node --test scripts/e2e/database-safety.test.mjs",
    "test:capacity": "node scripts/e2e/run.mjs --capacity",
    "test:restore-smoke": "node scripts/e2e/run.mjs --restore-smoke",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node --experimental-strip-types --experimental-specifier-resolution=node prisma/seed.ts"
  },
  "prisma": {
    "seed": "node --experimental-strip-types --experimental-specifier-resolution=node prisma/seed.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "6.19.0",
    "argon2": "0.43.0",
    "next": "15.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.54.1",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "22.15.21",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.31.0",
    "eslint-config-next": "15.4.2",
    "prisma": "6.19.0",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
