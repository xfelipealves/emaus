generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PersonStatus {
  VISITOR
  MEMBER
  INACTIVE
}

enum AccountRole {
  ADMINISTRATOR
  SECRETARY
  LEADER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum MinistryStatus {
  ACTIVE
  ARCHIVED
}

enum MinistryMembershipRole {
  MEMBER
  LEADER
}

model Person {
  id              String       @id @default(cuid())
  fullName        String
  status          PersonStatus @default(VISITOR)
  phone           String?
  birthDate       DateTime?    @db.Date
  profilePhotoUrl String?
  statusChangedAt DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  account     Account?
  memberships MinistryMembership[]
}

model Account {
  id           String        @id @default(cuid())
  personId     String        @unique
  username     String        @unique
  email        String        @unique
  passwordHash String
  role         AccountRole   @default(SECRETARY)
  status       AccountStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  person         Person                  @relation(fields: [personId], references: [id])
  ministryAccess AccountMinistryAccess[]
}

model Ministry {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      MinistryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  memberships   MinistryMembership[]
  accountAccess AccountMinistryAccess[]
}

model MinistryMembership {
  id         String                 @id @default(cuid())
  personId   String
  ministryId String
  role       MinistryMembershipRole @default(MEMBER)
  startDate  DateTime               @db.Date
  endDate    DateTime?              @db.Date
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  person   Person   @relation(fields: [personId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@index([personId, startDate])
  @@index([ministryId, startDate])
}

model AccountMinistryAccess {
  id         String    @id @default(cuid())
  accountId  String
  ministryId String
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?

  account  Account  @relation(fields: [accountId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@unique([accountId, ministryId])
  @@index([ministryId])
}
