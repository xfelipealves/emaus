generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PersonStatus {
  VISITOR
  MEMBER
  INACTIVE
}

enum AccountRole {
  ADMINISTRATOR @map("ADMIN")
  SECRETARY
  LEADER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum MinistryStatus {
  ACTIVE
  ARCHIVED
}

enum MinistryMembershipRole {
  MEMBER
  LEADER
}

enum RecurrencePattern {
  WEEKLY
  BIWEEKLY
  MONTHLY

  @@map("MeetingRecurrence")
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  CANCELLED
}

enum MeetingAudienceType {
  WHOLE_CHURCH
  MINISTRIES
}

enum AttendanceStatus {
  NOT_CONFIRMED
  PRESENT
  ABSENT
}

enum ActivityBucket {
  TOMORROW
  BACKLOG
  PARKED
}

enum TimelineEventCategory {
  REGISTRATION
  STATUS
  MINISTRY
  ATTENDANCE
  NOTE
  CORRECTION
}

model Person {
  id              String       @id @default(cuid())
  fullName        String
  status          PersonStatus @default(VISITOR)
  phone           String?
  birthDate       DateTime?
  profilePhotoUrl String?      @map("photoUrl")
  statusChangedAt DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  account     Account?
  memberships MinistryMembership[]
  attendances Attendance[]
  notes       Note[]
  timeline    TimelineEvent[]
}

model Account {
  id           String        @id @default(cuid())
  personId     String        @unique
  username     String        @unique
  email        String        @unique
  passwordHash String
  role         AccountRole   @default(SECRETARY)
  status       AccountStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  person         Person                  @relation(fields: [personId], references: [id])
  ministryAccess AccountMinistryAccess[]
  notes          Note[]                  @relation("NoteAuthor")
  noteVersions   NoteVersion[]           @relation("NoteVersionAuthor")
  timelineEvents TimelineEvent[]         @relation("TimelineActor")
  auditEvents    AuditEvent[]            @relation("AuditActor")
  sessions       Session[]
}

model Session {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
}

model Activity {
  id          String         @id @default(cuid())
  title       String
  description String?
  bucket      ActivityBucket @default(BACKLOG)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  subtasks ActivitySubtask[]

  @@index([bucket, createdAt])
}

model ActivitySubtask {
  id         String   @id @default(cuid())
  activityId String
  title      String
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, createdAt])
}

model Ministry {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      MinistryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  memberships      MinistryMembership[]
  accountAccess    AccountMinistryAccess[]
  meetingAudiences MeetingAudience[]
}

model MinistryMembership {
  id         String                 @id @default(cuid())
  personId   String
  ministryId String
  role       MinistryMembershipRole @default(MEMBER)
  startDate  DateTime
  endDate    DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  person   Person   @relation(fields: [personId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@index([personId, startDate])
  @@index([ministryId, startDate])
}

model AccountMinistryAccess {
  id         String    @id @default(cuid())
  accountId  String
  ministryId String
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  account  Account  @relation(fields: [accountId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@unique([accountId, ministryId])
  @@index([accountId, revokedAt])
  @@index([ministryId, revokedAt])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  series   MeetingSeries[]
  meetings Meeting[]
}

model MeetingSeries {
  id         String            @id @default(cuid())
  categoryId String
  name       String
  recurrence RecurrencePattern
  weekdays   Int[]
  startDate  DateTime
  endDate    DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  category Category  @relation(fields: [categoryId], references: [id])
  meetings Meeting[]

  @@index([categoryId, startDate])
}

model Meeting {
  id          String        @id @default(cuid())
  categoryId  String
  seriesId    String?
  title       String
  scheduledAt DateTime      @map("startsAt")
  endsAt      DateTime?
  status      MeetingStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category    Category          @relation(fields: [categoryId], references: [id])
  series      MeetingSeries?    @relation(fields: [seriesId], references: [id])
  audiences   MeetingAudience[]
  attendances Attendance[]

  @@index([scheduledAt, status], map: "Meeting_startsAt_status_idx")
  @@index([seriesId, scheduledAt], map: "Meeting_seriesId_startsAt_idx")
}

model MeetingAudience {
  id         String              @id @default(cuid())
  meetingId  String
  type       MeetingAudienceType @default(MINISTRIES)
  ministryId String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  meeting  Meeting  @relation(fields: [meetingId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@unique([meetingId, ministryId])
  @@index([ministryId])
}

model Attendance {
  id        String           @id @default(cuid())
  meetingId String
  personId  String
  status    AttendanceStatus @default(NOT_CONFIRMED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id])
  person  Person  @relation(fields: [personId], references: [id])

  @@unique([meetingId, personId])
  @@index([personId])
}

model Note {
  id         String    @id @default(cuid())
  personId   String
  authorId   String?
  content    String    @default("")
  archived   Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  person   Person        @relation(fields: [personId], references: [id])
  author   Account?      @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  versions NoteVersion[]

  @@index([personId, createdAt])
  @@index([personId, archivedAt])
}

model NoteVersion {
  id        String   @id @default(cuid())
  noteId    String
  authorId  String?
  content   String
  sequence  Int
  createdAt DateTime @default(now())

  note   Note     @relation(fields: [noteId], references: [id])
  author Account? @relation("NoteVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([noteId, sequence])
  @@index([noteId, createdAt])
}

model TimelineEvent {
  id          String                 @id @default(cuid())
  personId    String
  actorId     String?
  category    TimelineEventCategory
  title       String
  description String?
  occurredAt  DateTime               @default(now())
  metadata    Json?
  createdAt   DateTime               @default(now())

  person Person  @relation(fields: [personId], references: [id])
  actor  Account? @relation("TimelineActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([personId, occurredAt])
  @@index([personId, category, occurredAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  targetType String
  targetId   String
  action     String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  actor Account? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}
