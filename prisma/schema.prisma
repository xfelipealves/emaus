generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PersonStatus {
  VISITOR
  MEMBER
  INACTIVE
}

enum AccountRole {
  ADMIN
  SECRETARY
  LEADER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum MinistryStatus {
  ACTIVE
  ARCHIVED
}

enum MinistryMembershipRole {
  LEADER
  MEMBER
}

enum MeetingRecurrence {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  CANCELLED
}

enum MeetingAudienceType {
  WHOLE_CHURCH
  MINISTRIES
}

enum AttendanceStatus {
  NOT_CONFIRMED
  PRESENT
  ABSENT
}

enum TimelineEventCategory {
  STATUS
  MINISTRY
  ATTENDANCE
  CORRECTION
  NOTE
}

model Person {
  id        String       @id @default(cuid())
  fullName  String
  status    PersonStatus @default(VISITOR)
  phone     String?
  birthDate DateTime?
  photoUrl  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  account     Account?
  memberships MinistryMembership[]
  attendances Attendance[]
  notes       Note[]
  timeline    TimelineEvent[]
}

model Account {
  id           String        @id @default(cuid())
  username     String        @unique
  email        String        @unique
  passwordHash String
  role         AccountRole   @default(SECRETARY)
  status       AccountStatus @default(ACTIVE)
  personId     String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  person           Person                  @relation(fields: [personId], references: [id])
  ministryAccesses AccountMinistryAccess[]
  authoredNotes    Note[]                  @relation("NoteAuthor")
  noteVersions     NoteVersion[]           @relation("NoteVersionAuthor")
  timelineEvents   TimelineEvent[]         @relation("TimelineActor")
  auditEvents      AuditEvent[]            @relation("AuditActor")
}

model Ministry {
  id        String         @id @default(cuid())
  name      String
  status    MinistryStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  memberships      MinistryMembership[]
  accesses         AccountMinistryAccess[]
  meetingAudiences MeetingAudience[]
}

model MinistryMembership {
  id         String                 @id @default(cuid())
  personId   String
  ministryId String
  role       MinistryMembershipRole
  startDate  DateTime
  endDate    DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  person   Person   @relation(fields: [personId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@index([personId, startDate])
  @@index([ministryId, startDate])
}

model AccountMinistryAccess {
  id         String    @id @default(cuid())
  accountId  String
  ministryId String
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  account  Account  @relation(fields: [accountId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@index([accountId, revokedAt])
  @@index([ministryId, revokedAt])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  series   MeetingSeries[]
  meetings Meeting[]
}

model MeetingSeries {
  id         String            @id @default(cuid())
  name       String
  categoryId String
  recurrence MeetingRecurrence
  weekdays   Int[]
  startDate  DateTime
  endDate    DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  category Category  @relation(fields: [categoryId], references: [id])
  meetings Meeting[]

  @@index([categoryId, startDate])
}

model Meeting {
  id         String        @id @default(cuid())
  title      String
  categoryId String
  seriesId   String?
  startsAt   DateTime
  endsAt     DateTime?
  status     MeetingStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  category    Category          @relation(fields: [categoryId], references: [id])
  series      MeetingSeries?    @relation(fields: [seriesId], references: [id])
  audiences   MeetingAudience[]
  attendances Attendance[]

  @@index([startsAt, status])
  @@index([seriesId, startsAt])
}

model MeetingAudience {
  id         String              @id @default(cuid())
  meetingId  String
  type       MeetingAudienceType
  ministryId String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  meeting  Meeting   @relation(fields: [meetingId], references: [id])
  ministry Ministry? @relation(fields: [ministryId], references: [id])

  @@unique([meetingId, ministryId])
  @@index([ministryId])
}

model Attendance {
  id        String           @id @default(cuid())
  meetingId String
  personId  String
  status    AttendanceStatus @default(NOT_CONFIRMED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id])
  person  Person  @relation(fields: [personId], references: [id])

  @@unique([meetingId, personId])
  @@index([personId, status])
}

model Note {
  id        String    @id @default(cuid())
  personId  String
  authorId  String?
  archivedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  person   Person        @relation(fields: [personId], references: [id])
  author   Account?      @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  versions NoteVersion[]

  @@index([personId, archivedAt])
}

model NoteVersion {
  id        String   @id @default(cuid())
  noteId    String
  authorId  String?
  content   String
  sequence  Int
  createdAt DateTime @default(now())

  note   Note     @relation(fields: [noteId], references: [id])
  author Account? @relation("NoteVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([noteId, sequence])
  @@index([noteId, createdAt])
}

model TimelineEvent {
  id          String                @id @default(cuid())
  personId    String
  actorId     String?
  category    TimelineEventCategory
  occurredAt DateTime              @default(now())
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime              @default(now())

  person Person  @relation(fields: [personId], references: [id])
  actor  Account? @relation("TimelineActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([personId, occurredAt])
  @@index([personId, category, occurredAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  targetType String
  targetId   String
  action     String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  actor Account? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}
