generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PersonStatus {
  VISITOR
  MEMBER
  INACTIVE
}

enum AccountRole {
  ADMIN
  SECRETARY
  LEADER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum MinistryStatus {
  ACTIVE
  ARCHIVED
}

enum MinistryMembershipRole {
  LEADER
  MEMBER
}

model Person {
  id        String       @id @default(cuid())
  fullName  String
  status    PersonStatus @default(VISITOR)
  phone     String?
  birthDate DateTime?
  photoUrl  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  account     Account?
  memberships MinistryMembership[]
}

model Account {
  id           String        @id @default(cuid())
  username     String        @unique
  email        String        @unique
  passwordHash String
  role         AccountRole   @default(SECRETARY)
  status       AccountStatus @default(ACTIVE)
  personId     String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  person           Person                  @relation(fields: [personId], references: [id])
  ministryAccesses AccountMinistryAccess[]
}

model Ministry {
  id        String         @id @default(cuid())
  name      String
  status    MinistryStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  memberships MinistryMembership[]
  accesses    AccountMinistryAccess[]
}

model MinistryMembership {
  id         String                 @id @default(cuid())
  personId   String
  ministryId String
  role       MinistryMembershipRole
  startDate  DateTime
  endDate    DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  person   Person   @relation(fields: [personId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@index([personId, startDate])
  @@index([ministryId, startDate])
}

model AccountMinistryAccess {
  id         String    @id @default(cuid())
  accountId  String
  ministryId String
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  account  Account  @relation(fields: [accountId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@index([accountId, revokedAt])
  @@index([ministryId, revokedAt])
}
