generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PersonStatus {
  VISITOR
  MEMBER
  INACTIVE
}

enum AccountRole {
  ADMINISTRATOR
  SECRETARY
  LEADER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum MinistryStatus {
  ACTIVE
  ARCHIVED
}

enum MinistryMembershipRole {
  MEMBER
  LEADER
}

enum RecurrencePattern {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  CANCELLED
}

enum AttendanceStatus {
  NOT_CONFIRMED
  PRESENT
  ABSENT
}

model Person {
  id              String       @id @default(cuid())
  fullName        String
  status          PersonStatus @default(VISITOR)
  phone           String?
  birthDate       DateTime?    @db.Date
  profilePhotoUrl String?
  statusChangedAt DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  account     Account?
  memberships MinistryMembership[]
  attendances Attendance[]
}

model Account {
  id           String        @id @default(cuid())
  personId     String        @unique
  username     String        @unique
  email        String        @unique
  passwordHash String
  role         AccountRole   @default(SECRETARY)
  status       AccountStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  person         Person                  @relation(fields: [personId], references: [id])
  ministryAccess AccountMinistryAccess[]
}

model Ministry {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      MinistryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  memberships      MinistryMembership[]
  accountAccess    AccountMinistryAccess[]
  meetingAudiences MeetingAudience[]
}

model MinistryMembership {
  id         String                 @id @default(cuid())
  personId   String
  ministryId String
  role       MinistryMembershipRole @default(MEMBER)
  startDate  DateTime               @db.Date
  endDate    DateTime?              @db.Date
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  person   Person   @relation(fields: [personId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@index([personId, startDate])
  @@index([ministryId, startDate])
}

model AccountMinistryAccess {
  id         String    @id @default(cuid())
  accountId  String
  ministryId String
  grantedAt  DateTime  @default(now())
  revokedAt  DateTime?

  account  Account  @relation(fields: [accountId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@unique([accountId, ministryId])
  @@index([ministryId])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  series   MeetingSeries[]
  meetings Meeting[]
}

model MeetingSeries {
  id         String            @id @default(cuid())
  categoryId String
  name       String
  recurrence RecurrencePattern
  weekdays   Int[]
  startDate  DateTime          @db.Date
  endDate    DateTime?         @db.Date
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  category Category  @relation(fields: [categoryId], references: [id])
  meetings Meeting[]

  @@index([categoryId, startDate])
}

model Meeting {
  id          String        @id @default(cuid())
  categoryId  String
  seriesId    String?
  title       String
  scheduledAt DateTime
  status      MeetingStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category    Category          @relation(fields: [categoryId], references: [id])
  series      MeetingSeries?    @relation(fields: [seriesId], references: [id])
  audiences   MeetingAudience[]
  attendances Attendance[]

  @@index([scheduledAt])
  @@index([seriesId])
}

model MeetingAudience {
  id         String @id @default(cuid())
  meetingId  String
  ministryId String

  meeting  Meeting  @relation(fields: [meetingId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@unique([meetingId, ministryId])
  @@index([ministryId])
}

model Attendance {
  id        String           @id @default(cuid())
  meetingId String
  personId  String
  status    AttendanceStatus @default(NOT_CONFIRMED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id])
  person  Person  @relation(fields: [personId], references: [id])

  @@unique([meetingId, personId])
  @@index([personId])
}
